.docker-secrets

# Environment files
.env
backend/.env

# Docker Compose local volumes (named volumes are not tracked)
docker-data/

# Node artifacts
node_modules/
backend/node_modules/
frontend/node_modules/

# Prisma generated client
# Using @prisma/client in node_modules; no local generated client tracked

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
frontend/build/
frontend/dist/
backend/dist/

# Local SQLite databases
backend/dev.db
backend/prisma/dev.db

# Tool caches (optional)
frontend/.vite/
backend/.tsbuildinfo