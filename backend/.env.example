# Copy to .env and adjust if needed
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_PORT=5432
DATABASE_URL="postgresql://your_db_user:your_secure_password@localhost:5432/dog_park_pals?schema=public"

# SSL/TLS Certificate Paths (optional - defaults to ../certs directory)
# CERT_PATH=/path/to/server.crt
# KEY_PATH=/path/to/server.key

# Frontend URL for CORS and Socket.io
FRONTEND_URL=https://localhost:5173

# Event Queue (RabbitMQ)
# ============================================================================
# SECURE DEFAULT: AMQPS (requires local certs)
EVENT_BUS_ENABLED=true
RABBITMQ_URL=amqps://localhost:5671
RABBITMQ_CA_PATH=../certs/rabbitmq.crt
RABBIT_SKIP_VERIFY=false
EVENT_QUEUE_NAME=dogpark.events
EVENT_QUEUE_MAX_RETRIES=5
EVENT_QUEUE_DLQ_NAME=dogpark.events.dlq

# Plaintext fallback for local debugging only:
# RABBITMQ_URL=amqp://localhost:5672
#
# ⚠️ Note: Backend will fail to start if RABBITMQ_CA_PATH doesn't exist when using amqps://
