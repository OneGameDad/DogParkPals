// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password_hash String
  username  String   @unique
  first_name      String?
  last_name       String?
  profilePictureUrl String?
  latitude  Float?
  longitude Float?
  dogOwnerships DogOwner[]
  checkIns  CheckIn[]
  favoriteParks UserFavoritePark[]
  eventsOrganized Event[] @relation("EventOrganizer")
  organizationsOwned Organization[] @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  role      UserRole @default(CLIENT)
  friendshipsRequested Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")
  enemies   enemies[] @relation("EnemyUser")
  enemiesOwned enemies[] @relation("EnemiesOwner")
  comments Comment[]
  messagesSent Messages[] @relation("MessageSender")
  messagesReceived Messages[] @relation("MessageReceiver")
  achievements UserAchievement[]
  levels    UserLevel[]
  ExpPoints   Int      @default(0)
  notifications Notification[]
  eventAttendances EventAttendance[]
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dog {
  id        Int      @id @default(autoincrement())
  name      String
  breed     DogBreed
  gender    String
  fixed     Boolean @default(false)
  dateOfBirth DateTime
  size      DogSize @default(MEDIUM)
  ownerRecords DogOwner[]
  profilePictureUrl String?
  vaccinationRecordUrl String?
  playstyle  DogPlaystyle @default(SOCIAL)
  description String?
  checkIns  CheckIn[]
  friendshipsRequested Friendship[] @relation("FriendshipRequesterDog")
  friendshipsReceived Friendship[] @relation("FriendshipAddresseeDog")
  ownerOfEnemies enemies[] @relation("EnemiesOwnerDog")
  enemyOf enemies[] @relation("EnemyDog")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Friendship {
  id              Int      @id @default(autoincrement())
  requesterId     Int?
  requester       User?    @relation("FriendshipRequester", fields: [requesterId], references: [id])
  requesterDogId  Int?
  requesterDog    Dog?     @relation("FriendshipRequesterDog", fields: [requesterDogId], references: [id])
  addresseeId     Int?
  addressee       User?    @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  addresseeDogId  Int?
  addresseeDog    Dog?     @relation("FriendshipAddresseeDog", fields: [addresseeDogId], references: [id])
  status          FriendshipStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Messages {
  id        Int      @id @default(autoincrement())
  senderId  Int
  receiverId Int
  content   String
  sentAt    DateTime @default(now())
  status    MessageStatus @default(SENT)

  sender    User @relation("MessageSender", fields: [senderId], references: [id])
  receiver  User @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([receiverId, status, sentAt])
  @@index([senderId])
  @@index([senderId, receiverId, sentAt])
}

model CheckIn {
  id           Int      @id @default(autoincrement())
  userId       Int
  dogId        Int?
  parkId       Int
  checkedInAt  DateTime @default(now())
  checkedOutAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dog   Dog?  @relation(fields: [dogId], references: [id], onDelete: Cascade)
  park  Park  @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@index([parkId, checkedInAt])
  @@index([userId])
  @@index([dogId])
}

// Table for enemies, they can be users or dogs, but are owned by users
model enemies {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  owner     User     @relation("EnemiesOwner", fields: [ownerId], references: [id])
  ownerDogId Int?
  ownerDog  Dog?     @relation("EnemiesOwnerDog", fields: [ownerDogId], references: [id])
  enemyUserId Int?
  enemyUser User?    @relation("EnemyUser", fields: [enemyUserId], references: [id])
  enemyDogId Int?
  enemyDog  Dog?     @relation("EnemyDog", fields: [enemyDogId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Park {
  id        Int      @id @default(autoincrement())
  name      String
  latitude  Float @default(0.0)
  longitude Float @default(0.0)
  description String?
  separateSmallDogArea Boolean @default(false)
  amenities Json?
  profilePictureUrl String?
  favoritedBy UserFavoritePark[]
  events Event[]
  comments  Comment[]
  checkIns  CheckIn[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
}

model DogOwner {
  userId Int
  dogId  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dog  Dog  @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@id([userId, dogId])
}

model UserFavoritePark {
  userId Int
  parkId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@id([userId, parkId])
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  profilePictureUrl String?
  websiteUrl String?
  description String?
  ownerId   Int
  owner     User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  membershipRecords OrganizationMember[]
  memberRole OrgRole @default(INVITEE)
  events    Event[] @relation("OrganizationEvents")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  userId         Int
  organizationId Int
  role           OrgRole @default(MEMBER)
  joinedAt       DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  private     EventPrivacy @default(PUBLIC)
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  parkId      Int
  park        Park     @relation(fields: [parkId], references: [id])
  organizationId Int?
  organization   Organization? @relation("OrganizationEvents", fields: [organizationId], references: [id])
  organizerId Int
  organizer   User     @relation("EventOrganizer", fields: [organizerId], references: [id])
  attendees  EventAttendance[]
  comments Comment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Join table for users attending events
model EventAttendance {
  userId  Int
  eventId Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, eventId])
  @@index([eventId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  parkId    Int?
  park      Park?     @relation(fields: [parkId], references: [id])
  eventId   Int?
  event     Event?    @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievements {
  id        Int      @id @default(autoincrement())
  name      String
  type      AchievementType @default(BADGE)
  description String?
  badgeUrl  String?
  userAchievements UserAchievement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserAchievement {
  userId        Int
  achievementId Int
  dateEarned    DateTime @default(now())

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement  Achievements @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model Levels {
  id        Int      @id @default(autoincrement())
  name      String
  description String?
  minPoints Int
  maxPoints Int
  badgeUrl  String?
  userLevels UserLevel[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserLevel {
  userId   Int
  levelId  Int
  dateAchieved DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  level   Levels @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([userId, levelId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      NotificationType
  payload   Json
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])    
}

// Enum for user roles in the organization
enum OrgRole {
  INVITEE
  MEMBER
  MODERATOR
  OWNER
  BANNED
}

// Enum for friendship status
enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum DogSize {
  TOY
  SMALL
  MEDIUM
  LARGE
  GIANT
  KAIJU
}

enum DogGender {  
  MALE
  FEMALE
}

// Enum for dog playstyle
enum DogPlaystyle {
  SOCIAL
  SHY
  AGGRESSIVE
  ENERGETIC
  CALM
}

enum Amenity {
  WATER_FOUNTAIN
  SHADE
  BENCHES
  WASTE_BAGS
  OBSTACLES
  AGILITY_EQUIPMENT
  BEACH_ACCESS
}

enum EventPrivacy {
  PUBLIC
  PRIVATE
}

enum AchievementType {
  BADGE
  TROPHY
  CERTIFICATE
}

