# ============================================================================
# DogParkPals Docker Environment Configuration
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to 'docker-secrets' (without -example suffix)
# 2. Fill in all the values with your actual credentials
# 3. NEVER commit 'docker-secrets' to git (it's in .gitignore)
# 
# ============================================================================

# Database Configuration
# ============================================================================
DATABASE_URL="file:./data/prod.db"

# JWT Authentication
# ============================================================================
# Generate a strong secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-jwt-secret-here-at-least-32-characters

# Google OAuth (Optional - remove if not using)
# ============================================================================
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://localhost:3000/auth/google/callback

# Frontend URL
# ============================================================================
FRONTEND_URL=https://localhost:5173

# Frontend API URL (used during build)
# ============================================================================
VITE_API_BASE_URL=https://localhost:3000

# SSL/TLS Certificates
# ============================================================================
# Paths to SSL certificate and key files mounted in Docker
# The certs directory is mounted as a volume in docker-compose.yml
CERT_PATH=/app/certs/server.crt
KEY_PATH=/app/certs/server.key

# Event Queue (RabbitMQ)
# ============================================================================
# SECURITY NOTE: This example shows AMQPS (encrypted) configuration.
# For local development, you may use AMQP (plaintext) to avoid cert setup:
#   RABBITMQ_URL=amqp://rabbitmq:5672
#   (Remove or comment out RABBITMQ_CA_PATH and RABBIT_SKIP_VERIFY)
#
# PRODUCTION: Use AMQPS with proper CA certificates for encrypted queue traffic.
# DEVELOPMENT: AMQP is acceptable for local work (faster setup, no certs needed).
#
# ⚠️ WARNING: Backend will crash if using amqps:// and RABBITMQ_CA_PATH is missing!

EVENT_BUS_ENABLED=true

# AMQPS Configuration (Production recommended, requires certs):
RABBITMQ_URL=amqps://rabbitmq:5671
RABBITMQ_CA_PATH=/app/certs/rabbitmq.crt
RABBIT_SKIP_VERIFY=false

# AMQP Configuration (Development alternative, no certs needed):
# RABBITMQ_URL=amqp://rabbitmq:5672

# Queue settings (applies to both AMQP and AMQPS):
EVENT_QUEUE_NAME=dogpark.events
EVENT_QUEUE_MAX_RETRIES=5
EVENT_QUEUE_DLQ_NAME=dogpark.events.dlq
RABBIT_USER=guest
RABBIT_PASSWORD=guest
PUBLISH_PORT=9419

# Elasticsearch (Observability - Optional)
# ============================================================================
ELASTIC_PASSWORD=elastic
ELASTICSEARCH_SSL_VERIFICATIONMODE=none

# Kibana -> Elasticsearch authentication (required for Kibana startup)
# Use ONE of the following approaches:

# Option 1: Service account token (recommended)
# ELASTICSEARCH_SERVICEACCOUNTTOKEN=replace_with_service_account_token

# Option 2: kibana_system credentials
# ELASTICSEARCH_USERNAME=kibana_system
# ELASTICSEARCH_PASSWORD=replace_with_kibana_system_password

# Java/Grafana Settings
# ============================================================================
# Low-resource defaults (can be increased on stronger machines)
ES_JAVA_OPTS=-Xms384m -Xmx384m
LS_JAVA_OPTS=-Xmx128m -Xms128m
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
