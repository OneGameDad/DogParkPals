{
  "version": "8.11.0",
  "objects": [
    {
      "type": "search",
      "id": "dogparkpals-all-logs",
      "attributes": {
        "title": "All Logs",
        "description": "View all application logs",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "dogparkpals-logs",
            "query": {
              "match_all": {}
            },
            "sort": [
              {
                "@timestamp": {
                  "order": "desc"
                }
              }
            ]
          }
        }
      }
    },
    {
      "type": "search",
      "id": "dogparkpals-errors",
      "attributes": {
        "title": "Errors & Warnings",
        "description": "Filter for error and warning level logs",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "dogparkpals-logs",
            "query": {
              "bool": {
                "must": [
                  {
                    "terms": {
                      "severity": ["error", "fatal", "warn"]
                    }
                  }
                ]
              }
            },
            "sort": [
              {
                "@timestamp": {
                  "order": "desc"
                }
              }
            ]
          }
        }
      }
    },
    {
      "type": "search",
      "id": "dogparkpals-domain-events",
      "attributes": {
        "title": "Domain Events (Audit Trail)",
        "description": "All event-driven domain events for audit trail",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "dogparkpals-logs",
            "query": {
              "match": {
                "context_type": "event"
              }
            },
            "sort": [
              {
                "@timestamp": {
                  "order": "desc"
                }
              }
            ]
          }
        }
      }
    },
    {
      "type": "search",
      "id": "dogparkpals-failed-jobs",
      "attributes": {
        "title": "Failed Background Jobs",
        "description": "JobFailed events from background job failures",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "dogparkpals-logs",
            "query": {
              "match": {
                "event_type": "job.failed"
              }
            },
            "sort": [
              {
                "@timestamp": {
                  "order": "desc"
                }
              }
            ]
          }
        }
      }
    },
    {
      "type": "search",
      "id": "dogparkpals-backup-events",
      "attributes": {
        "title": "Backup Lifecycle Events",
        "description": "Track backup operations (started, succeeded, failed)",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "dogparkpals-logs",
            "query": {
              "bool": {
                "must": [
                  {
                    "terms": {
                      "event_type": ["backup.started", "backup.succeeded", "backup.failed"]
                    }
                  }
                ]
              }
            },
            "sort": [
              {
                "@timestamp": {
                  "order": "desc"
                }
              }
            ]
          }
        }
      }
    },
    {
      "type": "search",
      "id": "dogparkpals-user-actions",
      "attributes": {
        "title": "User Actions (by User)",
        "description": "Filter logs by specific user_id - modify query to search for your user",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "dogparkpals-logs",
            "query": {
              "match": {
                "user_id": 1
              }
            },
            "sort": [
              {
                "@timestamp": {
                  "order": "desc"
                }
              }
            ]
          }
        }
      }
    },
    {
      "type": "search",
      "id": "dogparkpals-outbox-events",
      "attributes": {
        "title": "Outbox Publishing Activity",
        "description": "View outbox publisher logs and outbox event status",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "dogparkpals-logs",
            "query": {
              "bool": {
                "should": [
                  {
                    "match": {
                      "log_message": "outbox"
                    }
                  },
                  {
                    "match": {
                      "log_message": "publish"
                    }
                  }
                ]
              }
            },
            "sort": [
              {
                "@timestamp": {
                  "order": "desc"
                }
              }
            ]
          }
        }
      }
    },
    {
      "type": "search",
      "id": "dogparkpals-event-handler-perf",
      "attributes": {
        "title": "Event Handler Performance",
        "description": "Logs from event handlers with duration tracking",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": {
            "index": "dogparkpals-logs",
            "query": {
              "match": {
                "log_message": "handler"
              }
            },
            "sort": [
              {
                "@timestamp": {
                  "order": "desc"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
